    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@mcptoolshop/npm-launcher": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-tool-shop-org/comfy-preflight.git"
  },
  "homepage": "https://mcp-tool-shop-org.github.io/comfy-preflight/",
  "bugs": {
    "url": "https://github.com/mcp-tool-shop-org/comfy-preflight/issues"
  },
  "author": "mcp-tool-shop",
  "keywords": [
    "comfyui",
    "workflow",
    "preflight",
